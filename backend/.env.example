# Copy to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (mongodb+srv://user:password@cluster.../dbname)
MONGO_URL=

# Port the API listens on. Render injects this automatically in production.
PORT=8000

# Secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an issued token stays valid (zeit/ms format: 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins for CORS.
# Local dev: http://localhost:3000
# Production: https://your-frontend.onrender.com
CORS_ORIGIN=http://localhost:3000

# Optional TURN server for calls behind symmetric NAT / corporate firewalls.
# Leave blank to fall back to public STUN only (works on most home networks).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
